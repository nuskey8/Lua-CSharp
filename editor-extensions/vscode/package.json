{
  "name": "lua-csharp-debugger",
  "displayName": "Lua-CSharp Debugger",
  "description": "Attach to the embedded C# Lua-CSharp DAP server.",
  "version": "0.1.0",
  "publisher": "luacsharp",
  "engines": { "vscode": "^1.85.0" },
  "categories": ["Debuggers"],
  "activationEvents": ["onDebugResolve:lua-csharp"],
  "main": "./extension.js",
  "contributes": {
    "debuggers": [{
      "type": "lua-csharp",
      "label": "Lua-CSharp",
      "languages": ["lua"],
      "configurationAttributes": {
        "attach": {
          "properties": {
            "host": { "type": "string", "default": "127.0.0.1" },
            "port": { "type": "number", "default": 4711 },
            "stopOnEntry": { "type": "boolean", "default": true }
          }
        }
      },
      "initialConfigurations": [{
        "type": "lua-csharp", "request": "attach", "name": "Attach to Lua-CSharp",
        "host": "127.0.0.1", "port": 4711, "stopOnEntry": true
      }]
    }]
  }
}
