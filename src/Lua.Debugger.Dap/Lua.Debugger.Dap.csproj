<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0;netstandard2.1</TargetFrameworks>
    <LangVersion>13</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>LuaCSharp.Debugger.Dap</PackageId>
    <Description>Embedded C# Debug Adapter Protocol server for Lua-CSharp.</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Lua.Debugger/Lua.Debugger.csproj" />
    <PackageReference Include="System.Text.Json" Version="10.0.9" />
    <PackageReference
      Include="System.Threading.Channels"
      Version="10.0.9"
      Condition="'$(TargetFramework)' == 'netstandard2.1'"
    />
  </ItemGroup>
  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="README.md" />
    <None Include="../../Icon.png" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
