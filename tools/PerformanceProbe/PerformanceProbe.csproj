<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Lua/Lua.csproj" Condition="'$(LuaAssemblyPath)' == ''" />
    <Reference Include="Lua" Condition="'$(LuaAssemblyPath)' != ''">
      <HintPath>$(LuaAssemblyPath)</HintPath>
    </Reference>
    <PackageReference Include="BenchmarkDotNet" Version="0.15.8" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../../sandbox/Benchmark/n-body.lua" LogicalName="n-body.lua" />
  </ItemGroup>
</Project>
